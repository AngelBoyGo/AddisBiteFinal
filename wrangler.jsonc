{
  // Genspark hosted deploy (Cloudflare Workers for Platform).
  //
  // The published site bundle is the committed ./dist tree, built by
  //   ./tools/build-dist.sh
  // It contains, under one origin:
  //   /                    landing + auth / partner / attribution / thanks
  //   /console/            Operations Console (dispatch)
  //   /admin/              Admin dashboard
  //   /app/customer.html   Customer app
  //   /app/courier.html    Courier app
  //
  // Static assets only — no Worker script, no bindings, no cron. Dashboard
  // links are patched into the dist copy alone (tools/patch-links.mjs).
  "name": "addisbites",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  }
}
