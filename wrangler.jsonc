{
  // Genspark hosted deploy (Cloudflare Workers for Platform).
  //
  // The published bundle is the committed ./dist tree, built by
  //   ./tools/build-dist.sh
  // It contains, under one origin:
  //   /                    landing + auth / partner / attribution / thanks
  //   /console/            Operations Console (dispatch)
  //   /admin/              Admin dashboard
  //   /app/customer.html   Customer app
  //   /app/courier.html    Courier app
  //
  // src/index.js serves the ASSETS binding and proxies /api/* server-to-server
  // to the Addis Bites API (that is what removes the browser CORS failure).
  // Storage is untouched: no D1, no KV (unsupported by the hosted pipeline),
  // no R2, no cron triggers.
  // Dashboard links are patched into the dist copy alone (tools/patch-links.mjs).
  "name": "addisbites",
  "main": "src/index.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  }
}
