# ---- build output ----------------------------------------------------------
# dist/ IS committed on purpose: the Genspark hosted pipeline publishes the
# tracked tree, and wrangler.jsonc serves ./dist as the site bundle. Rebuild it
# with ./tools/build-dist.sh before committing.
ops-console/dist/
ops-admin/dist/

# ---- dependencies ---------------------------------------------------------
node_modules/
.yarn/
!.yarn/releases

# ---- secrets: never commit --------------------------------------------------
.env
.env.*
!.env.example
.dev.vars
.netlify/
.nf/
.netlify-cli/

# ---- cloudflare local state -----------------------------------------------
.wrangler/

# ---- logs -----------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- editors / os ---------------------------------------------------------
.vscode/*
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf
.DS_Store

# ---- misc -----------------------------------------------------------------
*.pid
pids/
.pm2/
*.backup
*.bak
*.tar.gz
*.zip

# ---- generated: rebuild with `node tools/build-pages.mjs` -----------------
# The eight site/*.html pages are generated from tools/build-pages.mjs, but we
# DO commit them: Netlify Forms must be able to crawl them at deploy time, and
# the repo should be readable without running a build first.

# Local preview assembly (generated by tools/assemble-preview.sh)
preview/
